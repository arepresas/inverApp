{
  "name": "inverapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .vue,.ts",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate:new": "supabase migration new",
    "db:migrate:up": "supabase migration up",
    "db:migrate:list": "supabase migration list",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f"
  },
  "dependencies": {
    "@mozaic-ds/datatable-vue": "^1.0.1",
    "@mozaic-ds/vue": "^2.19.0",
    "@supabase/supabase-js": "^2.106.2",
    "pinia": "^3.0.4",
    "tslib": "^2.8.1",
    "vue": "^3.5.35",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mozaic-ds/css-dev-tools": "^1.75.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.1.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "supabase": "^2.101.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.2"
  }
}
